---
/**
 * Calendar365 — the year as a living artwork, and the best sales argument
 * on the site.
 *
 * 365 cells. Filled cells are days that have a finished piece; empty cells are
 * days still to come. It does three jobs at once:
 *   1. shows the collection growing (returning visitors see progress),
 *   2. makes every individual day clickable and buyable,
 *   3. sells the annual composite — the whole grid becomes one 1-of-1 piece
 *      sold on New Year's Day.
 */
import pieces from '../data/pieces.json';

const YEAR = Number(import.meta.env.PUBLIC_YEAR ?? 2026);
const byDay: Record<number, any> = {};
for (const p of pieces as any[]) {
  const day = p.day ?? Math.floor((Date.parse(p.date) - Date.parse(`${YEAR}-01-01`)) / 86400000) + 1;
  if (day >= 1 && day <= 365) byDay[day] = p;
}
const done = Object.keys(byDay).length;
const pct = Math.round((done / 365) * 100);
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const LENGTHS = [31,28,31,30,31,30,31,31,30,31,30,31];
let cursor = 0;
const months = MONTHS.map((name, i) => {
  const days = Array.from({ length: LENGTHS[i] }, () => ({ n: ++cursor, month: i + 1, dom: cursor - (i ? LENGTHS.slice(0, i).reduce((a, b) => a + b, 0) : 0) }));
  return { name, days };
});

// Day lookup for the finder. Keyed MM-DD so a birthday matches regardless of
// the year someone was born — the piece is tied to a calendar day, not a date.
const finderMap: Record<string, any> = {};
for (const m of months) {
  for (const d of m.days) {
    const p = byDay[d.n];
    if (p) finderMap[`${String(m.days[0].month).padStart(2, '0')}-${String(d.dom).padStart(2, '0')}`] =
      { id: p.id, title: p.title, day: d.n };
  }
}
const BASE = Number(import.meta.env.PUBLIC_BASE_PRICE ?? 300);
---
<section class="year" id="year">
  <div class="year-head">
    <div>
      <h2>FREETHINKERS {YEAR}</h2>
      <p class="year-sub">
        One finished work every day. On New Year's Day the whole grid becomes a
        single 1-of-1 piece — and the {YEAR + 1} canvas begins.
      </p>
    </div>
    <div class="year-stat">
      <span class="year-count">{done}</span><span class="year-of">/365</span>
      <div class="year-track"><div class="year-fill" style={`width:${pct}%`}></div></div>
      <span class="year-pct">{pct}% complete</span>
    </div>
  </div>

  <!-- Own your day: turns the calendar from a progress bar into a storefront,
       and an art purchase into a gift purchase with a built-in occasion. -->
  <div class="ownday">
    <div class="ownday-copy">
      <h3>Own your day</h3>
      <p>
        A birthday. An anniversary. The day your kid was born. Every date in
        {YEAR} is a one-of-one piece — find yours and it's yours for good.
      </p>
    </div>
    <form class="ownday-form" id="ownday-form">
      <label for="ownday-date" class="sr-only">Pick a date</label>
      <input type="date" id="ownday-date" required />
      <button class="button" type="submit">Find my day</button>
    </form>
  </div>

  <div class="ownday-result" id="ownday-result" hidden></div>

  <div class="months">
    {months.map((m) => (
      <div class="month">
        <span class="month-name">{m.name}</span>
        <div class="month-grid">
          {m.days.map((d) => {
            const piece = byDay[d.n];
            const key = `${String(m.days[0].month).padStart(2, '0')}-${String(d.dom).padStart(2, '0')}`;
            return piece ? (
              <a class="day filled" href={`/art/${piece.id}`}
                 style={`--h:${[...piece.id].reduce((h: number, c: string) => (h * 31 + c.charCodeAt(0)) % 360, 0)}`}
                 title={`${m.name} ${d.dom} — ${piece.title}`} data-day={d.n} data-key={key}>
                <span class="day-tip">{piece.title}</span>
              </a>
            ) : (
              <span class="day empty" title={`${m.name} ${d.dom} — not yet`} data-day={d.n} data-key={key}></span>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <script type="application/json" id="ownday-data" set:html={JSON.stringify(finderMap)} />
  <script define:vars={{ BASE, YEAR }}>
    const MAP = JSON.parse(document.getElementById('ownday-data').textContent);
    const form = document.getElementById('ownday-form');
    const out = document.getElementById('ownday-result');
    const MONTH_NAMES = ['January','February','March','April','May','June','July',
      'August','September','October','November','December'];

    function show(key, label) {
      const hit = MAP[key];
      document.querySelectorAll('.day.target').forEach((d) => d.classList.remove('target'));
      const cell = document.querySelector(`.day[data-key="${key}"]`);
      if (cell) {
        cell.classList.add('target');
        cell.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      out.innerHTML = hit
        ? `<p class="od-label">${label} is <strong>Day ${hit.day}</strong></p>
           <h4>${hit.title}</h4>
           <div class="od-cta">
             <a class="button" href="/art/${hit.id}">Own this day — $${BASE}</a>
             <a class="ghost-link" href="/a/${hit.id}">See the certificate →</a>
           </div>
           <p class="od-fine">One piece per day. Once it's sold, that date is gone.</p>`
        : `<p class="od-label">${label} hasn't been made yet.</p>
           <p class="od-fine">The ${YEAR} year is still being painted — that day is coming.
             Leave your email and you'll be first to know when it lands.</p>
           <form class="signup" id="od-waitlist">
             <input type="email" name="email" required placeholder="you@email.com" aria-label="Email" />
             <button class="button" type="submit">Notify me</button>
           </form>
           <p class="form-msg" id="od-msg" hidden></p>`;
      out.hidden = false;

      const wl = document.getElementById('od-waitlist');
      wl?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = new FormData(wl).get('email');
        const msg = document.getElementById('od-msg');
        try {
          const API = 'https://api.freethinkers.ai';
          const r = await fetch(`${API}/api/subscribe`, {
            method: 'POST', headers: { 'content-type': 'application/json' },
            // The requested day rides along, so you know which dates people want
            body: JSON.stringify({ email, list: `ownday:${key}` }),
          });
          if (!r.ok) throw new Error();
          msg.textContent = `You're on the list for ${label}.`;
        } catch {
          msg.textContent = 'Couldn’t reach the list — email vault@freethinkers.ai and I’ll add you.';
        }
        msg.hidden = false;
        wl.reset();
      });
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = document.getElementById('ownday-date').value;
      if (!v) return;
      // Year is ignored on purpose — a birthday is a calendar day, and the
      // person entering 1987 wants the piece for that month and day.
      const [, mm, dd] = v.split('-');
      show(`${mm}-${dd}`, `${MONTH_NAMES[Number(mm) - 1]} ${Number(dd)}`);
    });

    // Deep link: /#day=03-14 so a date can be shared or posted directly
    const hash = location.hash.match(/day=(\d{2})-(\d{2})/);
    if (hash) show(`${hash[1]}-${hash[2]}`, `${MONTH_NAMES[Number(hash[1]) - 1]} ${Number(hash[2])}`);
  </script>

  <div class="year-cta">
    <p>
      <strong>Want the whole year?</strong> The {YEAR} composite is a single piece,
      sold once, on January 1. Collectors on the list get first refusal.
    </p>
    <form class="signup" id="year-signup">
      <input type="email" name="email" required placeholder="you@email.com" aria-label="Email" />
      <button class="button" type="submit">Get first refusal</button>
    </form>
    <p class="form-msg" id="year-msg" hidden></p>
  </div>
</section>

<script>
  const API = document.documentElement.dataset.api ?? 'https://api.freethinkers.ai';
  const form = document.getElementById('year-signup');
  const msg = document.getElementById('year-msg');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = new FormData(form).get('email');
    try {
      const r = await fetch(`${API}/api/subscribe`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, list: 'annual' }),
      });
      if (!r.ok) throw new Error();
      msg.textContent = "You're on the list for the annual piece.";
    } catch {
      msg.textContent = 'List is warming up — email vault@freethinkers.ai and I’ll add you by hand.';
    }
    msg.hidden = false;
    form.reset();
  });
</script>
