---
/**
 * Gallery — filterable grid of finished works, with optional motion.
 *
 * Motion is progressive: a piece shows its clip only if catalog.csv gives it
 * one. Everything works with zero clips, and each clip you add lights up on its
 * own. That matters when you have 180 pieces and clips for six of them.
 *
 * Behaviour:
 *   · hover a tile with a clip → the clip fades in over the still and loops
 *   · leave → it fades back to the still
 *   · open a piece → still and motion sit side by side
 *   · the Motion/Stills toggle is remembered per visitor, and motion is off
 *     by default for anyone who asked their OS for reduced motion
 *
 * Stills are drawn to <canvas> so the DOM holds no saveable source. Clips are
 * deliberately short, muted, low-res previews — treat them as marketing, the
 * same way the 1080p still is.
 */
import pieces from '../data/pieces.json';
// Images come from the local folder ingest publishes into, so the site works
// on your machine with no API deployed. Point PUBLIC_IMG_BASE at the worker
// (https://api.freethinkers.ai/img) once R2 delivery is live.
const IMG = import.meta.env.PUBLIC_IMG_BASE ?? '/art-previews';
const API = import.meta.env.PUBLIC_API_BASE ?? 'https://api.freethinkers.ai';
const CLIPS = import.meta.env.PUBLIC_CLIP_BASE ?? `${API}/clip`;
const tags = [...new Set((pieces as any[]).flatMap((p) => p.tags ?? []))].sort();
const hasAnyClip = (pieces as any[]).some((p) => p.clip);
---
<section class="gallery-section" id="gallery">
  <div class="section-head">
    <h2>The collection</h2>
    <div class="gallery-controls">
      <button class="chip active" data-tag="" type="button">All</button>
      {tags.map((t) => <button class="chip" data-tag={t} type="button">{t}</button>)}
    </div>
  </div>

  {pieces.length === 0 && (
    <div class="gallery-empty">
      <p><strong>No art loaded yet.</strong></p>
      <p>Run the pipeline to publish your pieces here:</p>
      <code>node ingest.mjs "$DROP" --signature "$SIG" --artist "Adrian A. Grimaldo"</code>
      <p class="fine">Then restart the dev server. This message disappears once pieces.json has your work in it.</p>
    </div>
  )}

  <div class="gallery" id="gallery-grid"></div>

  {hasAnyClip && (
    <div class="motion-toggle">
      <button id="motion-btn" type="button" aria-pressed="false">
        <span class="dot"></span><span id="motion-label">Motion off</span>
      </button>
      <span class="motion-hint">Hover a piece with a clip to see it move</span>
    </div>
  )}
</section>

<div class="lightbox" id="ft-lightbox" hidden>
  <button class="lb-close" id="ft-close" aria-label="Close">✕</button>
  <button class="lb-nav lb-prev" id="ft-prev" aria-label="Previous">‹</button>
  <figure class="lb-figure">
    <div class="lb-stage" id="lb-stage">
      <canvas id="ft-canvas"></canvas>
      <video id="ft-video" class="lb-video" muted loop playsinline preload="none" hidden></video>
    </div>
    <figcaption>
      <div>
        <strong id="ft-title"></strong>
        <span id="ft-meta"></span>
        <p class="lb-story" id="ft-story"></p>
      </div>
      <a class="button small" id="ft-link" href="#">Own this piece →</a>
    </figcaption>
  </figure>
  <button class="lb-nav lb-next" id="ft-next" aria-label="Next">›</button>
</div>

<script type="application/json" id="piece-data" set:html={JSON.stringify(pieces)} />
<script define:vars={{ IMG, CLIPS }}>
  const ALL = JSON.parse(document.getElementById('piece-data').textContent);
  const grid = document.getElementById('gallery-grid');
  let view = ALL.slice();

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let motion = !reduced && localStorage.getItem('ft-motion') === 'on';

  const hue = (id) => [...id].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 0);
  const placeholder = (id) =>
    `linear-gradient(${hue(id)}deg, hsl(${hue(id)} 45% 25%), hsl(${(hue(id) + 50) % 360} 40% 12%))`;

  /* ---------- grid ---------- */
  function render() {
    grid.innerHTML = '';
    const frag = document.createDocumentFragment();
    view.forEach((p) => {
      // Every tile is the same square regardless of the source aspect ratio.
      // Mixed ratios made the grid ragged; uniform cells let the collection
      // read as one continuous work — which is the whole 365 idea. Full aspect
      // is preserved on the piece page and in the lightbox.
      const el = document.createElement('article');
      el.className = 'g-tile' + (p.clip ? ' has-clip' : '');
      el.dataset.id = p.id;
      if (p.clip) el.dataset.clip = `${CLIPS}/${p.clip}`;
      el.innerHTML = `
        <div class="g-frame">
          <div class="g-art" style="background:${placeholder(p.id)}" data-src="${IMG}/${p.id}.png"></div>
          ${p.clip ? '<span class="g-badge" title="This piece has a motion version">▶</span>' : ''}
          <div class="g-info">
            <h3>${p.title}</h3>
            <span class="g-day">Day ${p.day ?? '—'} · ${p.date ?? ''}</span>
          </div>
        </div>`;
      frag.appendChild(el);
    });
    grid.appendChild(frag);
    lazy();
  }

  const io = new IntersectionObserver((es) => {
    for (const e of es) {
      if (!e.isIntersecting) continue;
      const d = e.target; io.unobserve(d);
      const img = new Image();
      img.onload = () => { d.style.backgroundImage = `url(${img.src})`; d.classList.add('loaded'); };
      img.src = d.dataset.src;
    }
  }, { rootMargin: '300px' });
  const lazy = () => grid.querySelectorAll('.g-art:not(.loaded)').forEach((d) => io.observe(d));

  /* ---------- hover motion ----------
     The <video> is created on first hover and never preloaded, so a gallery of
     180 pieces costs nothing until someone actually reaches for a clip. */
  function attachClip(tile) {
    if (!motion || !tile.dataset.clip || tile.querySelector('video')) return;
    const v = document.createElement('video');
    v.className = 'g-video';
    v.muted = true; v.loop = true; v.playsInline = true; v.preload = 'auto';
    v.src = tile.dataset.clip;
    v.addEventListener('canplay', () => tile.classList.add('clip-ready'));
    tile.querySelector('.g-frame').appendChild(v);
  }

  grid.addEventListener('pointerenter', (e) => {
    const t = e.target.closest?.('.g-tile.has-clip');
    if (!t || !motion) return;
    attachClip(t);
    t.querySelector('video')?.play?.().catch(() => {});
  }, true);

  grid.addEventListener('pointerleave', (e) => {
    const t = e.target.closest?.('.g-tile.has-clip');
    if (!t) return;
    const v = t.querySelector('video');
    if (v) { v.pause(); v.currentTime = 0; }
    t.classList.remove('clip-ready');
  }, true);

  /* ---------- motion toggle ---------- */
  const btn = document.getElementById('motion-btn');
  function syncMotion() {
    if (!btn) return;
    btn.setAttribute('aria-pressed', String(motion));
    btn.classList.toggle('on', motion);
    document.getElementById('motion-label').textContent = motion ? 'Motion on' : 'Motion off';
    document.body.classList.toggle('motion-on', motion);
    if (!motion) {
      grid.querySelectorAll('.g-tile video').forEach((v) => { v.pause(); v.remove(); });
      grid.querySelectorAll('.g-tile').forEach((t) => t.classList.remove('clip-ready'));
    }
  }
  btn?.addEventListener('click', () => {
    motion = !motion;
    localStorage.setItem('ft-motion', motion ? 'on' : 'off');
    syncMotion();
    paintIfOpen();
  });

  /* ---------- filters ---------- */
  document.querySelector('.gallery-controls').addEventListener('click', (e) => {
    const c = e.target.closest('.chip');
    if (!c) return;
    document.querySelectorAll('.chip').forEach((x) => x.classList.toggle('active', x === c));
    const t = c.dataset.tag;
    view = t ? ALL.filter((p) => (p.tags ?? []).includes(t)) : ALL.slice();
    render();
  });

  /* ---------- lightbox: still and motion side by side ---------- */
  const lb = document.getElementById('ft-lightbox');
  const canvas = document.getElementById('ft-canvas');
  const video = document.getElementById('ft-video');
  const stage = document.getElementById('lb-stage');
  let idx = -1;

  function paint() {
    const p = view[idx]; if (!p) return;
    document.getElementById('ft-title').textContent = p.title;
    document.getElementById('ft-meta').textContent = ` · ${p.id} · Day ${p.day ?? '—'}`;
    document.getElementById('ft-story').textContent = p.story ?? '';
    document.getElementById('ft-link').href = `/art/${p.id}`;

    const showClip = Boolean(p.clip) && motion;
    stage.classList.toggle('paired', showClip);
    video.hidden = !showClip;
    if (showClip) {
      video.src = `${CLIPS}/${p.clip}`;
      video.play().catch(() => {});
    } else {
      video.pause(); video.removeAttribute('src'); video.load();
    }

    const ctx = canvas.getContext('2d');
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => { canvas.width = img.naturalWidth; canvas.height = img.naturalHeight; ctx.drawImage(img, 0, 0); };
    img.onerror = () => {
      canvas.width = 900; canvas.height = 900;
      const g = ctx.createLinearGradient(0, 0, 900, 900);
      g.addColorStop(0, `hsl(${hue(p.id)} 45% 25%)`);
      g.addColorStop(1, `hsl(${(hue(p.id) + 50) % 360} 40% 12%)`);
      ctx.fillStyle = g; ctx.fillRect(0, 0, 900, 900);
      ctx.fillStyle = 'rgba(246,244,239,.55)'; ctx.font = '30px sans-serif'; ctx.textAlign = 'center';
      ctx.fillText(`${p.title} — preview pending`, 450, 450);
    };
    img.src = `${IMG}/${p.id}.png`;
  }
  const paintIfOpen = () => { if (!lb.hidden) paint(); };

  const open = (id) => { idx = view.findIndex((p) => p.id === id); paint(); lb.hidden = false; document.body.style.overflow = 'hidden'; };
  const close = () => {
    lb.hidden = true; document.body.style.overflow = '';
    video.pause(); video.removeAttribute('src'); video.load();
  };
  const step = (d) => { idx = (idx + d + view.length) % view.length; paint(); };

  grid.addEventListener('click', (e) => {
    const t = e.target.closest('.g-tile'); if (t) open(t.dataset.id);
  });
  document.getElementById('ft-close').addEventListener('click', close);
  document.getElementById('ft-prev').addEventListener('click', () => step(-1));
  document.getElementById('ft-next').addEventListener('click', () => step(1));
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
  for (const ev of ['contextmenu', 'dragstart'])
    document.addEventListener(ev, (e) => { if (e.target.closest('.g-art, .lb-figure, .g-video')) e.preventDefault(); });

  render();
  syncMotion();
</script>
