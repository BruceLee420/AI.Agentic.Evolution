# Copy to .env (and into Cloudflare Pages env vars). NEVER commit the real .env.

# ---------- checkout rail ----------
# gumroad | stripe | snipcart   — start on gumroad, flip when Snipcart is approved
PUBLIC_CHECKOUT_PROVIDER=gumroad

# Fast-rail payment links (Gumroad / Stripe Payment Link URLs)
PUBLIC_PAY_URL_SINGLE=          # FTWlabs single concept  ($19)
PUBLIC_PAY_URL_BUNDLE=          # FTWlabs 10-pack         ($99)
PUBLIC_PAY_URL_MINT=            # Freethinkers master     ($300)
PUBLIC_PAY_URL_PRINT=           # Fine art print          ($80)
PUBLIC_PAY_URL_PRESS=           # QR sweatshirt           ($65)

# ---------- API ----------
# Before DNS: https://freethinkers-api.<subdomain>.workers.dev
PUBLIC_API_BASE=https://api.freethinkers.ai

# ---------- Snipcart (phase 2) ----------
PUBLIC_SNIPCART_KEY=            # public key → site build
SNIPCART_SECRET=                # secret key → wrangler secret put SNIPCART_SECRET

# ---------- Printful ----------
PRINTFUL_KEY=

# ---------- Cloudflare ----------
CLOUDFLARE_ACCOUNT_ID=
PRICING_NS=                     # wrangler kv namespace create PRICING
ENTITLEMENTS_NS=                # wrangler kv namespace create ENTITLEMENTS
SIGNING_KEY=                    # openssl rand -hex 32 → wrangler secret put SIGNING_KEY

# ---------- pricing knobs ----------
PUBLIC_BASE_PRICE=300
PUBLIC_TIER_SIZE=12
PUBLIC_TIER_PCT=12
PUBLIC_PRINT_PRICE=80
PUBLIC_PRESS_PRICE=65
PUBLIC_CONCEPT_PRICE=19
PUBLIC_BUNDLE_SIZE=10
PUBLIC_BUNDLE_PRICE=99
PUBLIC_BUNDLE_EXTRA=8
PUBLIC_YEAR=2026
FREE_APPAREL_FROM_TIER=1
DOWNLOAD_TTL_HOURS=72
DOWNLOAD_MAX_USES=3
