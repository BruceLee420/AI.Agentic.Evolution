---
/**
 * Calendar365 — the year as a living artwork, and the best sales argument
 * on the site.
 *
 * 365 cells. Filled cells are days that have a finished piece; empty cells are
 * days still to come. It does three jobs at once:
 *   1. shows the collection growing (returning visitors see progress),
 *   2. makes every individual day clickable and buyable,
 *   3. sells the annual composite — the whole grid becomes one 1-of-1 piece
 *      sold on New Year's Day.
 */
import pieces from '../data/pieces.json';

const YEAR = Number(import.meta.env.PUBLIC_YEAR ?? 2026);
const byDay: Record<number, any> = {};
for (const p of pieces as any[]) {
  const day = p.day ?? Math.floor((Date.parse(p.date) - Date.parse(`${YEAR}-01-01`)) / 86400000) + 1;
  if (day >= 1 && day <= 365) byDay[day] = p;
}
const done = Object.keys(byDay).length;
const pct = Math.round((done / 365) * 100);
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const LENGTHS = [31,28,31,30,31,30,31,31,30,31,30,31];
let cursor = 0;
const months = MONTHS.map((name, i) => {
  const days = Array.from({ length: LENGTHS[i] }, () => ++cursor);
  return { name, days };
});
---
<section class="year" id="year">
  <div class="year-head">
    <div>
      <h2>FREETHINKERS {YEAR}</h2>
      <p class="year-sub">
        One finished work every day. On New Year's Day the whole grid becomes a
        single 1-of-1 piece — and the {YEAR + 1} canvas begins.
      </p>
    </div>
    <div class="year-stat">
      <span class="year-count">{done}</span><span class="year-of">/365</span>
      <div class="year-track"><div class="year-fill" style={`width:${pct}%`}></div></div>
      <span class="year-pct">{pct}% complete</span>
    </div>
  </div>

  <div class="months">
    {months.map((m) => (
      <div class="month">
        <span class="month-name">{m.name}</span>
        <div class="month-grid">
          {m.days.map((d) => {
            const piece = byDay[d];
            return piece ? (
              <a class="day filled" href={`/art/${piece.id}`}
                 style={`--h:${[...piece.id].reduce((h: number, c: string) => (h * 31 + c.charCodeAt(0)) % 360, 0)}`}
                 title={`Day ${d} — ${piece.title}`} data-day={d}>
                <span class="day-tip">{piece.title}</span>
              </a>
            ) : (
              <span class="day empty" title={`Day ${d} — not yet`} data-day={d}></span>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <div class="year-cta">
    <p>
      <strong>Want the whole year?</strong> The {YEAR} composite is a single piece,
      sold once, on January 1. Collectors on the list get first refusal.
    </p>
    <form class="signup" id="year-signup">
      <input type="email" name="email" required placeholder="you@email.com" aria-label="Email" />
      <button class="button" type="submit">Get first refusal</button>
    </form>
    <p class="form-msg" id="year-msg" hidden></p>
  </div>
</section>

<script>
  const API = document.documentElement.dataset.api ?? 'https://api.freethinkers.ai';
  const form = document.getElementById('year-signup');
  const msg = document.getElementById('year-msg');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = new FormData(form).get('email');
    try {
      const r = await fetch(`${API}/api/subscribe`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, list: 'annual' }),
      });
      if (!r.ok) throw new Error();
      msg.textContent = "You're on the list for the annual piece.";
    } catch {
      msg.textContent = 'List is warming up — email vault@freethinkers.ai and I’ll add you by hand.';
    }
    msg.hidden = false;
    form.reset();
  });
</script>
